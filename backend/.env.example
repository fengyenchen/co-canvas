# 使用 AI 模式
AI_MODE=gemini
GEMINI_API_KEY=your-api-key

# 使用 mock 模式 
# AI_MODE=mock

GEMINI_MODEL=gemini-3.6-flash

# 用於加密使用者自行設定的 Gemini API Key
# 可使用以下指令產生：
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AI_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-generated-fernet-key

# Neon database connection string
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# Neon direct connection string for Alembic migrations
DATABASE_MIGRATION_URL=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require

# Neon Auth public key set URL for verifying user JWTs
NEON_AUTH_JWKS_URL=https://your-neon-auth-jwks-url
